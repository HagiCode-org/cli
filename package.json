{
  "name": "@hagicode/cli",
  "version": "0.1.0",
  "description": "HagiCode CLI for project, proposal, vault, chat, and AutoTask management.",
  "homepage": "https://github.com/HagiCode-org/cli#readme",
  "bugs": {
    "url": "https://github.com/HagiCode-org/cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HagiCode-org/cli.git"
  },
  "bin": {
    "hagi": "dist/cli.js"
  },
  "main": "./dist/main.js",
  "files": [
    "dist",
    "README.md",
    "skills",
    "resources/saga"
  ],
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "export NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=8192\"; pnpm run clean && vite build",
    "dev": "tsx ./src/cli.ts",
    "generate:grpc": "node ./buildTools/generate-grpc.mjs",
    "generate:grpc:check": "node ./buildTools/generate-grpc.mjs --check",
    "pack:check": "node ./scripts/verify-package.mjs",
    "saga:assets:sync": "node ./scripts/sync-saga-assets.mjs --skill ../personal-agent-skills/long-running-orchestration",
    "saga:assets:check": "node ./scripts/sync-saga-assets.mjs --skill ../personal-agent-skills/long-running-orchestration --check",
    "publish:resolve-dev-version": "node ./scripts/resolve-dev-version.mjs",
    "publish:verify-release": "node ./scripts/verify-release-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "export NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=8192\"; tsc --noEmit -p tsconfig.json",
    "check:registry": "node scripts/check-registry-neutrality.mjs",
    "test:registry": "node --test scripts/check-registry-neutrality.node-test.mjs"
  },
  "keywords": [
    "hagicode",
    "hagicode-org",
    "cli",
    "openspec",
    "proposal",
    "autotask",
    "vault",
    "ai-agent",
    "agentic-coding"
  ],
  "author": "HagiCode",
  "license": "AGPL-3.0-or-later",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@types/node": "^25.0.2",
    "rimraf": "^6.1.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.5"
  }
}
